<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp">

    <TextView
        android:id="@+id/groupCourseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:text="Графический дизайн"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/groupBranchText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Филиал: Центральный"
        android:textColor="@color/hint_gray"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/groupScheduleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Расписание: ПН, СР 10:00-11:30"
        android:textColor="@color/hint_gray"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/groupStudentsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Ученики 2/12"
        android:textColor="@color/hint_gray"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/groupActionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Открыть занятия  ›"
        android:textColor="@color/orange_main"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>